@{
    ViewData["Title"] = "Servicios - VORTEX Renewables";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components/_page-hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/_services.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/_service-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/_services-cta.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/services.css" asp-append-version="true" />
}

<partial name="~/Views/Shared/Components/_PageHero.cshtml" model='@(new PageHeroViewModel
{
    Title = "Servicios",
    Breadcrumbs =
    [
        new BreadcrumbItem { Label = "Inicio", Url = "/" },
        new BreadcrumbItem { Label = "Servicios" }
    ]
})' />


@* Tarjetas destacadas de servicios *@
<section class="section services">
    <div class="container">
        <partial name="~/Views/Shared/Components/_ServiceCards.cshtml" />
    </div>
</section>

@* CTA final *@
<partial name="~/Views/Services/Components/_ServicesCta.cshtml" />

@using vortex.web.Models
@{
    ViewData["Title"] = "Sobre Nosotros - VORTEX Renewables";

    var heroViewModel = new PageHeroViewModel
    {
        Title = "Sobre Nosotros",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem { Label = "Inicio", Url = Url.Action("Index", "Landing") },
            new BreadcrumbItem { Label = "Sobre Nosotros" }
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/components/_page-hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/_quote.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/about-us.css" asp-append-version="true" />
}

@await Html.PartialAsync("~/Views/Shared/Components/_PageHero.cshtml", heroViewModel)

<section class="section about-us-container">
    <div class="container">
        <!-- Main About Us Section -->
        <div class="about-essence-grid">
            <!-- Text Content -->
            <div class="about-essence-content">
                <div>
                    <div class="about-essence-label">Nuestra Esencia</div>
                </div>
                <h2 class="about-essence-title">
                    Conectando con la <span class="highlight">energía limpia</span>
                </h2>
                
                <p class="about-essence-description">
                    Vortex Renewables es una empresa especializada en el Desarrollo y Estructuración de Proyectos de energía renovable. Combinamos ingeniería, gestión ambiental y experiencia jurídica para convertir recursos naturales en energía que impulsa comunidades y empresas de manera sostenible.
                </p>
                <p class="about-essence-description">
                    Nuestro compromiso es ofrecer un enfoque integral para cada proyecto, garantizando el respeto por el medio ambiente y promoviendo el desarrollo tecnológico a favor de la eficiencia energética y la sostenibilidad de nuestro país.
                </p>
            </div>
            
            <!-- Image Content -->
            <div class="about-essence-image-wrapper">
                <img src="~/images/institucional-nosotros.webp" alt="Transformando el futuro energético" class="about-essence-image" />
                <div class="about-essence-caption">
                    <h4 class="caption-subtitle">Sostenibilidad</h4>
                    <p class="caption-title">Transformando el futuro energético</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Interstitial Banner Phrase (Consistent with _Quote.cshtml) -->
<section class="quote-section">
    <div class="container">
        <div class="quote-wrapper">
            <div class="quote-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z" />
                </svg>
            </div>
           <blockquote class="quote-text">
                "La energía del mañana se construye hoy, aprovechando la fuerza inagotable de la naturaleza."
            </blockquote>
            <div class="quote-author">
                <div class="author-name">VORTEX Renewables</div>
                <div class="author-title">Desarrollo y Estructuración de Proyectos</div>
            </div>
        </div>
    </div>
</section>

<!-- Humanized Mission & Vision Section -->
<section class="section human-section">
    <div class="container">
        
        <div class="human-grid" style="margin-bottom: var(--spacing-3xl);">
            <!-- Image left, Text Right (Mission) -->
            <div class="human-image-wrapper">
                <div class="human-image-inner">
                    <img src="~/images/institucional-mision.webp" alt="Transición energética justa" class="human-image" />
                    <div class="human-image-caption">
                        <p class="caption-subtitle">Transición Justa</p>
                        <p class="caption-title">Innovación y sostenibilidad para comunidades</p>
                    </div>
                </div>
            </div>
            <div class="human-content-box">
                <div class="human-header-wrapper" style="align-items: center;">
                    <div class="human-icon-box">
                        <span class="material-icons">eco</span>
                    </div>
                    <div class="human-text-content">
                        <h2 class="human-title" style="margin: 0 0 4px 0;">Nuestra Misión</h2>
                        <div class="human-subtitle" style="color: #b0b0b0; font-weight: 500; margin-bottom: 8px; margin-top: 0;">Bienestar Social y Ambiental</div>
                    </div>
                </div>
                <p class="human-desc">
                    Impulsar la transición hacia un futuro más limpio y sustentable, proveyendo soluciones de energía renovable innovadoras, eficientes y accesibles. Trabajamos de la mano con la naturaleza y las comunidades, enfocándonos en la estructuración de proyectos que generen no solo vatios de energía, sino también bienestar social, desarrollo económico y cuidado medioambiental genuino.
                </p>
            </div>
        </div>

        <div class="human-grid">
            <!-- Text Left, Image Right (Vision) -->
            <div class="human-content-box vision-box">
                <div class="human-header-wrapper" style="align-items: center;">
                    <div class="human-icon-box">
                        <span class="material-icons">visibility</span>
                    </div>
                    <div class="human-text-content">
                        <h2 class="human-title" style="margin: 0 0 4px 0;">Nuestra Visión</h2>
                        <div class="human-subtitle" style="color: #b0b0b0; font-weight: 500; margin-bottom: 8px; margin-top: 0;">Excelencia y Compromiso</div>
                    </div>
                </div>
                <p class="human-desc">
                    Consolidarnos como una empresa referente en el Desarrollo y Estructuración de Proyectos de energía renovable a nivel nacional e internacional, reconocidos por la solidez técnica, la excelencia operativa y nuestro inquebrantable compromiso ambiental. Aspiramos a ser el motor que inspire a organizaciones de todo tipo a adoptar modelos de producción energética en completa armonía con nuestro planeta.
                </p>
            </div>
            <div class="human-image-wrapper">
                <div class="human-image-inner">
                    <img src="~/images/institucional-vision.webp" alt="Visión de futuro limpio" class="human-image" />
                    <div class="human-image-caption">
                        <p class="caption-subtitle">Visión de Futuro</p>
                        <p class="caption-title">Inspirando modelos energéticos responsables</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

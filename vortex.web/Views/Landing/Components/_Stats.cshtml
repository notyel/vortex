@* Stats Section - Sección de Experiencia Destacada *@

<section id="estadisticas" class="section stats">
    <div class="container">

        <div class="stats-header">
            <div class="stats-label">
                <span class="stats-label-line"></span>
                <span class="stats-label-text">NUESTRA EXPERIENCIA</span>
            </div>
            <h2 class="stats-title">
                Números que respaldan <span class="stats-highlight">nuestra trayectoria</span>
            </h2>
        </div>

        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-icon">
                    <span class="material-icons" aria-hidden="true">bolt</span>
                </div>
                <span class="stat-number">+100</span>
                <span class="stat-divider"></span>
                <span class="stat-label">MW desarrollados en proyectos Utility-Scale</span>
            </div>

            <div class="stat-item">
                <div class="stat-icon">
                    <span class="material-icons" aria-hidden="true">solar_power</span>
                </div>
                <span class="stat-number">+20</span>
                <span class="stat-divider"></span>
                <span class="stat-label">Instalaciones de generación distribuida</span>
            </div>

            <div class="stat-item">
                <div class="stat-icon">
                    <span class="material-icons" aria-hidden="true">ev_station</span>
                </div>
                <span class="stat-number">#1</span>
                <span class="stat-divider"></span>
                <span class="stat-label">Primer corredor de carga rápida privada en Colombia</span>
            </div>
        </div>

    </div>
</section>

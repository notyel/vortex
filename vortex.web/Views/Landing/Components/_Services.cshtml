@* Services Section - Sección de Servicios *@

<section id="servicios" class="section services">
    <div class="container">
        <h2 class="section-title">Nuestros Servicios</h2>
        
        <div class="grid grid-cols-2">
            <div class="service-card">
                <div class="service-icon">
                    <span class="material-icons icon-xl">bolt</span>
                </div>
                <h3 class="service-title">Desarrollo y estructuración de proyectos (Utility-Scale)</h3>
                <p class="service-description">
                    Soluciones integrales para proyectos de energía renovable a gran escala.
                </p>
                <ul class="service-list">
                    <li>Identificación y aseguramiento de terrenos estratégicos</li>
                    <li>Gestión de permisos ambientales, sociales y regulatorios</li>
                    <li>Ingeniería conceptual, básica y de detalle</li>
                    <li>Modelación financiera y estructuración de PPAs</li>
                    <li>Acompañamiento hasta RTB (Ready-to-Build) y soporte hasta COD (Commercial Operation Date)</li>
                    <li>Gestión de beneficios tributarios UPME</li>
                    <li>Certificaciones RETIE</li>
                </ul>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <span class="material-icons icon-xl">search</span>
                </div>
                <h3 class="service-title">Due Diligence Integral para Proyectos Renovables</h3>
                <p class="service-description">
                    <strong>Enfoque:</strong> Confianza, claridad y respaldo para sus decisiones de inversión.
                </p>
                <p class="service-description">
                    Evaluación rigurosa, multidisciplinaria y en terreno para identificar riesgos, 
                    garantizar la bancabilidad y facilitar el desarrollo o adquisición. Brinda una visión completa: 
                    técnica, legal, financiera, ambiental y social.
                </p>
                <ul class="service-list">
                    <li>Due Diligence Técnica</li>
                    <li>Due Diligence Financiera</li>
                    <li>Due Diligence Ambiental y Social (E&S)</li>
                    <li>Scouting y Verificación en Campo</li>
                </ul>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <span class="material-icons icon-xl">solar_power</span>
                </div>
                <h3 class="service-title">Generación distribuida y autogeneración</h3>
                <p class="service-description">
                    Sistemas de energía solar y almacenamiento para diferentes sectores.
                </p>
                <ul class="service-list">
                    <li>Sistemas solares fotovoltaicos residenciales, comerciales e industriales</li>
                    <li>Sistemas híbridos con almacenamiento en baterías</li>
                    <li>Optimización de autoconsumo y contratos PPA on-site</li>
                    <li>Servicios de operación, monitoreo y mantenimiento 24/7</li>
                </ul>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <span class="material-icons icon-xl">ev_station</span>
                </div>
                <h3 class="service-title">Soluciones de electromovilidad</h3>
                <p class="service-description">
                    Infraestructura completa para vehículos eléctricos.
                </p>
                <ul class="service-list">
                    <li>Diseño e instalación de electrolineras públicas y privadas</li>
                    <li>Integración de cargadores inteligentes Nivel 2 y DC Fast</li>
                    <li>Conversión y renovación de flotas corporativas a vehículos eléctricos</li>
                    <li>Operación y mantenimiento de infraestructura de carga</li>
                </ul>
            </div>
        </div>
    </div>
</section>

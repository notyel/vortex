@* Services Section - Sección de Servicios *@

<section id="servicios" class="section services">
    <div class="container">
        <div class="services-header">
            <div class="services-label">
                <span class="label-line"></span>
                <span class="label-text">NUESTROS SERVICIOS</span>
            </div>
            <h2 class="services-title">
                Soluciones integrales para impulsar la <span class="highlight">transición energética</span> de tu empresa.
            </h2>
        </div>
        
        <div class="services-tabs-container">
            <!-- Pestañas laterales -->
            <div class="services-tabs">
                <button class="service-tab active" data-service="utility-scale">
                    <div class="tab-icon">
                        <span class="material-icons">bolt</span>
                    </div>
                    <div class="tab-content">
                        <h3 class="tab-title">Desarrollo y estructuración de proyectos</h3>
                        <p class="tab-subtitle">Utility-Scale</p>
                    </div>
                </button>
                
                <button class="service-tab" data-service="due-diligence">
                    <div class="tab-icon">
                        <span class="material-icons">search</span>
                    </div>
                    <div class="tab-content">
                        <h3 class="tab-title">Due Diligence Integral</h3>
                        <p class="tab-subtitle">Proyectos Renovables</p>
                    </div>
                </button>
                
                <button class="service-tab" data-service="distribuida">
                    <div class="tab-icon">
                        <span class="material-icons">solar_power</span>
                    </div>
                    <div class="tab-content">
                        <h3 class="tab-title">Generación distribuida</h3>
                        <p class="tab-subtitle">Autogeneración</p>
                    </div>
                </button>
                
                <button class="service-tab" data-service="electromovilidad">
                    <div class="tab-icon">
                        <span class="material-icons">ev_station</span>
                    </div>
                    <div class="tab-content">
                        <h3 class="tab-title">Soluciones de electromovilidad</h3>
                        <p class="tab-subtitle">Infraestructura EV</p>
                    </div>
                </button>
            </div>
            
            <!-- Contenido de servicios -->
            <div class="services-content">
                <div class="service-content active" data-service="utility-scale">
                    <h3 class="service-content-title">Desarrollo y estructuración de proyectos (Utility-Scale)</h3>
                    <p class="service-description">
                        Soluciones integrales para proyectos de energía renovable a gran escala.
                    </p>
                    <div class="service-features">
                        <div class="feature-item">
                            <span class="material-icons">location_on</span>
                            <span>Identificación y aseguramiento de terrenos estratégicos</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">gavel</span>
                            <span>Gestión de permisos ambientales, sociales y regulatorios</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">engineering</span>
                            <span>Ingeniería conceptual, básica y de detalle</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">analytics</span>
                            <span>Modelación financiera y estructuración de PPAs</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">trending_up</span>
                            <span>Acompañamiento hasta RTB (Ready-to-Build) y soporte hasta COD (Commercial Operation Date)</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">account_balance</span>
                            <span>Gestión de beneficios tributarios UPME</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">verified</span>
                            <span>Certificaciones RETIE</span>
                        </div>
                    </div>
                </div>
                
                <div class="service-content" data-service="due-diligence">
                    <h3 class="service-content-title">Due Diligence Integral para Proyectos Renovables</h3>
                    <p class="service-description">
                        <strong>Enfoque:</strong> Confianza, claridad y respaldo para sus decisiones de inversión.
                    </p>
                    <p class="service-description">
                        Evaluación rigurosa, multidisciplinaria y en terreno para identificar riesgos, 
                        garantizar la bancabilidad y facilitar el desarrollo o adquisición. Brinda una visión completa: 
                        técnica, legal, financiera, ambiental y social.
                    </p>
                    <div class="service-features">
                        <div class="feature-item">
                            <span class="material-icons">build</span>
                            <span>Due Diligence Técnica</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">payments</span>
                            <span>Due Diligence Financiera</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">nature</span>
                            <span>Due Diligence Ambiental y Social (E&S)</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">explore</span>
                            <span>Scouting y Verificación en Campo</span>
                        </div>
                    </div>
                </div>
                
                <div class="service-content" data-service="distribuida">
                    <h3 class="service-content-title">Generación distribuida y autogeneración</h3>
                    <p class="service-description">
                        Sistemas de energía solar y almacenamiento para diferentes sectores.
                    </p>
                    <div class="service-features">
                        <div class="feature-item">
                            <span class="material-icons">wb_sunny</span>
                            <span>Sistemas solares fotovoltaicos residenciales, comerciales e industriales</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">battery_charging_full</span>
                            <span>Sistemas híbridos con almacenamiento en baterías</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">settings_suggest</span>
                            <span>Optimización de autoconsumo y contratos PPA on-site</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">support_agent</span>
                            <span>Servicios de operación, monitoreo y mantenimiento 24/7</span>
                        </div>
                    </div>
                </div>
                
                <div class="service-content" data-service="electromovilidad">
                    <h3 class="service-content-title">Soluciones de electromovilidad</h3>
                    <p class="service-description">
                        Infraestructura completa para vehículos eléctricos.
                    </p>
                    <div class="service-features">
                        <div class="feature-item">
                            <span class="material-icons">power</span>
                            <span>Diseño e instalación de electrolineras públicas y privadas</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">electrical_services</span>
                            <span>Integración de cargadores inteligentes Nivel 2 y DC Fast</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">electric_car</span>
                            <span>Conversión y renovación de flotas corporativas a vehículos eléctricos</span>
                        </div>
                        <div class="feature-item">
                            <span class="material-icons">handyman</span>
                            <span>Operación y mantenimiento de infraestructura de carga</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Botón para volver a las pestañas (solo móvil) -->
        <button class="back-to-tabs-btn" id="backToTabsBtn">
            <span class="material-icons">arrow_upward</span>
            <span class="btn-text">Ver otro servicio</span>
        </button>
        
        @* Título para las tarjetas de servicios *@
        <div class="services-cards-header">
            <div class="services-label">
                <span class="label-line"></span>
                <span class="label-text">POR QUÉ ELEGIRNOS</span>
            </div>
            <h2 class="services-title">
                Acompañamos a tu organización en cada paso hacia una <span class="highlight">transformación energética</span> sostenible y eficiente.
            </h2>
        </div>
        
        @* Feature Cards *@
        <div class="feature-cards">
            <div class="feature-card">
                <div class="card-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h3 class="card-title">Soluciones Integrales</h3>
                <p class="card-description">Desde la concepción hasta la operación, acompañamos cada etapa de tu proyecto de energía renovable.</p>
            </div>
            
            <div class="feature-card featured">
                <div class="card-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h3 class="card-title">Experiencia Comprobada</h3>
                <p class="card-description">Más de 30 años desarrollando proyectos exitosos de energía limpia en toda Latinoamérica.</p>
            </div>
            
            <div class="feature-card">
                <div class="card-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M17 21V19C17 17.9391 16.5786 16.9217 15.8284 16.1716C15.0783 15.4214 14.0609 15 13 15H5C3.93913 15 2.92172 15.4214 2.17157 16.1716C1.42143 16.9217 1 17.9391 1 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/>
                        <path d="M23 21V19C22.9993 18.1137 22.7044 17.2528 22.1614 16.5523C21.6184 15.8519 20.8581 15.3516 20 15.13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M16 3.13C16.8604 3.35031 17.623 3.85071 18.1676 4.55232C18.7122 5.25392 19.0078 6.11683 19.0078 7.005C19.0078 7.89318 18.7122 8.75608 18.1676 9.45769C17.623 10.1593 16.8604 10.6597 16 10.88" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h3 class="card-title">Soporte Continuo</h3>
                <p class="card-description">Asesoría permanente y atención especializada para garantizar el máximo rendimiento de tu inversión.</p>
            </div>
        </div>
        
        @* Tarjeta de impacto con imagen de fondo *@
        <div class="impact-card">
            <div class="impact-card-overlay">
                <div class="impact-card-content">
                    <h3 class="impact-title">Transformando comunidades y <span class="highlight">vidas</span> con <span class="highlight">energía limpia</span> todos los días</h3>
                    <p class="impact-description">
                        Cada proyecto <strong>VORTEX</strong> va más allá de generar megavatios. Creamos <strong>empleos dignos</strong>, 
                        impulsamos el desarrollo local y construimos un <strong>futuro sostenible</strong> para las próximas generaciones. 
                        Nuestra energía limpia transforma industrias, mejora la calidad de vida y protege el medio ambiente.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tabs = document.querySelectorAll('.service-tab');
        const contents = document.querySelectorAll('.service-content');
        const backToTabsBtn = document.getElementById('backToTabsBtn');
        
        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                const serviceId = this.getAttribute('data-service');
                
                // Remover active de todas las pestañas y contenidos
                tabs.forEach(t => t.classList.remove('active'));
                contents.forEach(c => c.classList.remove('active'));
                
                // Agregar active a la pestaña clickeada y su contenido
                this.classList.add('active');
                document.querySelector(`.service-content[data-service="${serviceId}"]`).classList.add('active');
            });
        });
        
        // Funcionalidad para el botón de volver a las pestañas
        if (backToTabsBtn) {
            backToTabsBtn.addEventListener('click', function() {
                const tabsContainer = document.querySelector('.services-tabs');
                if (tabsContainer) {
                    tabsContainer.scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'start' 
                    });
                }
            });
        }
    });
</script>

@* Hero Section - Sección principal de bienvenida con slider *@

<section class="hero-slider">
    <div class="hero-slide active" style="background-image: url('/images/slider-1.jpg');">
        <div class="hero-overlay"></div>
        <div class="hero-content container">
            <div class="hero-inner">
                <p class="hero-pretitle text-primary">Energía Solar y Renovable</p>
                <h1 class="hero-title">
                    Energía <span class="text-primary">limpia</span> para tu <span class="text-primary">futuro</span>
                </h1>
                <p class="hero-subtitle">
                    Impulsando nuestra posición como proveedor internacional de energía renovable a través de soluciones solares y eólicas flexibles e integradas.
                </p>
                <div class="hero-buttons">
                    <a href="#contacto" class="btn-hero btn-hero-primary">Contáctanos</a>
                    <a href="#nosotros" class="btn-hero btn-hero-secondary">Conocer más</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="hero-slide" style="background-image: url('/images/slider-2.jpg');">
        <div class="hero-overlay"></div>
        <div class="hero-content container">
            <div class="hero-inner">
                <p class="hero-pretitle text-primary">Innovación y Sustentabilidad</p>
                <h1 class="hero-title">
                    <span class="hero-title-main">Tecnología <span class="text-primary">limpia</span></span><br>
                    para el <span class="text-primary">futuro</span>
                </h1>
                <p class="hero-subtitle">
                    Transformando el futuro energético con tecnología de punta y compromiso sustentable para un planeta más limpio y eficiente.
                </p>
                <div class="hero-buttons">

    <div class="hero-slide" style="background-image: url('/images/slider-3.jpg');">
        <div class="hero-overlay"></div>
        <div class="hero-content container">
            <div class="hero-inner">
                <p class="hero-pretitle text-primary">VORTEX Renewables</p>
                <h1 class="hero-title">
                    Energía <span class="text-primary">limpia</span><br>
                    para tu <span class="text-primary">empresa</span>
                </h1>
                <p class="hero-subtitle">

@* Hero Section - Sección principal de bienvenida con slider *@

<div class="hero-wrapper">
    <section class="hero-slider">
        <div class="hero-slide active" style="background-image: url('/images/slider-1.jpg');">
            <div class="hero-overlay"></div>
            <div class="hero-content container">
                <div class="hero-inner">
                    <p class="hero-pretitle text-primary">Energía Solar y Renovable</p>
                    <h1 class="hero-title">
                        Tu <span class="text-primary">futuro</span> brillante con <span class="text-primary">energía solar</span>
                    </h1>
                    <p class="hero-subtitle">
                        Soluciones innovadoras en energía solar que impulsan la transición hacia un futuro sostenible y eficiente para tu hogar y empresa.
                    </p>
                    <div class="hero-buttons">
                        <a href="#contacto" class="btn-hero btn-hero-primary">
                            Contáctanos 
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                        <a href="#nosotros" class="btn-hero btn-hero-secondary">
                            Conocer más 
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="hero-slide" style="background-image: url('/images/slider-2.jpg');">
            <div class="hero-overlay"></div>
            <div class="hero-content container">
                <div class="hero-inner">
                    <p class="hero-pretitle text-primary">Innovación y Sustentabilidad</p>
                    <h1 class="hero-title">
                        Tecnología <span class="text-primary">verde</span> que <span class="text-primary">transforma</span>
                    </h1>
                    <p class="hero-subtitle">
                        Implementamos tecnología de vanguardia para crear soluciones energéticas sustentables que cuidan el planeta y optimizan recursos.
                    </p>
                    <div class="hero-buttons">
                        <a href="#contacto" class="btn-hero btn-hero-primary">
                            Contáctanos 
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                        <a href="#nosotros" class="btn-hero btn-hero-secondary">
                            Conocer más 
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="hero-slide" style="background-image: url('/images/slider-3.jpg');">
            <div class="hero-overlay"></div>
            <div class="hero-content container">
                <div class="hero-inner">
                    <p class="hero-pretitle text-primary">VORTEX Renewables</p>
                    <h1 class="hero-title">
                        Potencia tu <span class="text-primary">empresa</span> sustentablemente
                    </h1>
                    <p class="hero-subtitle">
                        Desarrollamos sistemas de energía limpia personalizados que reducen costos operativos e impulsan la responsabilidad ambiental corporativa.
                    </p>
                    <div class="hero-buttons">
                        <a href="#contacto" class="btn-hero btn-hero-primary">
                            Contáctanos 
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                        <a href="#nosotros" class="btn-hero btn-hero-secondary">
                            Conocer más 
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="hero-indicators">
            <span class="indicator active" data-slide="0"></span>
            <span class="indicator" data-slide="1"></span>
            <span class="indicator" data-slide="2"></span>
        </div>
        
        @* Feature Cards - DESKTOP ONLY - Paneles superpuestos al borde del hero *@
        <div class="hero-features hero-features-desktop">
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <span class="material-symbols-outlined">energy_savings_leaf</span>
                    </div>
                    <div class="feature-content">
                        <h3 class="feature-title">Energía Limpia</h3>
                        <p class="feature-description">Soluciones sostenibles que reducen tu huella de carbono y protegen el medio ambiente.</p>
                    </div>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <span class="material-symbols-outlined">support_agent</span>
                    </div>
                    <div class="feature-content">
                        <h3 class="feature-title">Soporte 24/7</h3>
                        <p class="feature-description">Asistencia técnica continua para garantizar el óptimo funcionamiento de tu sistema solar.</p>
                    </div>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <span class="material-symbols-outlined">workspace_premium</span>
                    </div>
                    <div class="feature-content">
                        <h3 class="feature-title">Expertos Certificados</h3>
                        <p class="feature-description">Equipo profesional con amplia experiencia en instalación y mantenimiento de sistemas solares.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>


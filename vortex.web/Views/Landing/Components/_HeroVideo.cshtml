@* Hero Video - Sección principal con fondo de video *@

<div class="hero-video-wrapper">
    <section class="hero-video-section">
        @* Video de fondo *@
        <div class="hero-video-bg">
            <video id="hero-bg-video" muted loop playsinline preload="none" poster="/images/hero-bg-placeholder.jpg">
                <source data-src="/video/hero-bg-video.mp4" type="video/mp4" />
            </video>
        </div>

        <div class="hero-video-overlay"></div>

        <div class="hero-video-content container">
            <div class="hero-video-inner">
                <p class="hero-pretitle text-primary">Desarrollo <span class="material-symbols-outlined hero-pretitle-sep">fiber_manual_record</span> Estructuración <span class="material-symbols-outlined hero-pretitle-sep">fiber_manual_record</span> Ingeniería</p>
                <h1 class="hero-title">
                    Proyectos de <span class="text-primary">Energía Renovable</span>
                </h1>
                <p class="hero-subtitle">
                    Somos una empresa especializada en el desarrollo, ingeniería y estructuración integral de proyectos solares y de energía renovable, impulsando la transición energética sostenible para empresas e industrias.
                </p>
            </div>
        </div>

            </section>
        </div>

<script>
    (function () {
        var video = document.getElementById('hero-bg-video');
        if (!video) return;
        function loadVideo() {
            var source = video.querySelector('source[data-src]');
            if (source) {
                source.src = source.getAttribute('data-src');
                source.removeAttribute('data-src');
            }
            video.load();
            video.play().catch(function () {});
        }
        if ('requestIdleCallback' in window) {
            requestIdleCallback(loadVideo);
        } else {
            window.addEventListener('load', loadVideo);
        }
    })();
</script>

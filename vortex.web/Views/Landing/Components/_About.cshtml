<section id="nosotros" class="section about">
    <div class="container">
        <div class="about-content">
            <div class="about-image-container">
                <div class="about-image-wrapper">
                    <img src="~/images/01.jpg" alt="Vortex Renewables - Energía Renovable" class="about-image" />
                    <div class="about-image-caption">
                        <p class="caption-subtitle">Especialistas en</p>
                        <p class="caption-title">Desarrollo y estructuración de proyectos<br />a gran escala y soluciones de autogeneración</p>
                    </div>
                </div>
            </div>
            
            <div class="about-text-container">
                <div class="about-header">
                    <div class="about-label">
                        <span class="label-line"></span>
                        <span class="label-text">SOBRE NOSOTROS</span>
                    </div>
                    <h2 class="about-title">
                        Vortex Renewables es una compañía pionera en <span class="highlight">soluciones energéticas 100% limpias.</span>
                    </h2>
                </div>
                
                <p class="about-description">
                    Combinamos ingeniería, gestión ambiental y experiencia jurídica para convertir vórtices  
                    naturales en energía que impulsa comunidades y empresas.
                </p>

                <p class="about-services-intro">
                    En Vortex ofrecemos servicios especializados para proyectos de energía renovable a escala industrial.
                </p>

                <div class="about-features">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <span class="material-symbols-outlined">bolt</span>
                        </div>
                        <div class="feature-content">
                            <h3 class="feature-title">Desarrollo y Estructuración de Proyectos</h3>
                            <p class="feature-description">Utility-Scale</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <span class="material-symbols-outlined">policy</span>
                        </div>
                        <div class="feature-content">
                            <h3 class="feature-title">Due Diligence Integral</h3>
                            <p class="feature-description">Proyectos Renovables</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <span class="material-symbols-outlined">solar_power</span>
                        </div>
                        <div class="feature-content">
                            <h3 class="feature-title">Generación Distribuida</h3>
                            <p class="feature-description">Autogeneración</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <span class="material-symbols-outlined">ev_station</span>
                        </div>
                        <div class="feature-content">
                            <h3 class="feature-title">Soluciones de Electromovilidad</h3>
                            <p class="feature-description">Infraestructura EV</p>
                        </div>
                    </div>
                </div>
                
                <a href="#servicios" class="about-cta">
                    Ver Nuestros Servicios
                    <svg viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </a>
            </div>
        </div>
        

        @* Feature Cards *@
        <div class="feature-cards-divider"></div>

        <div class="feature-cards-intro">
            <p class="feature-cards-intro-text">
                Desde el desarrollo de grandes proyectos hasta soluciones personalizadas y presencia en todo el territorio, 
                nuestro trabajo se sostiene en tres pilares fundamentales.
            </p>
        </div>

        <div class="feature-cards">
            <div class="feature-card">
                <div class="card-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 5a2 2 0 012-2h2a2 2 0 012 2v0a2 2 0 01-2 2h-2a2 2 0 01-2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h3 class="card-title">Desarrollo Integral de Proyectos</h3>
                <p class="card-description">Gestionamos cada etapa del proyecto, desde la prefactibilidad hasta la puesta en operación, garantizando resultados sostenibles.</p>
            </div>

            <div class="feature-card featured">
                <div class="card-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2a7 7 0 017 7c0 2.38-1.19 4.47-3 5.74V17a1 1 0 01-1 1H9a1 1 0 01-1-1v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 017-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 21h6M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </div>
                <h3 class="card-title">Soluciones Energéticas a la Medida</h3>
                <p class="card-description">Diseñamos soluciones adaptadas a las necesidades específicas de cada cliente, optimizando costos y eficiencia energética.</p>
            </div>

            <div class="feature-card">
                <div class="card-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
                    </svg>
                </div>
                <h3 class="card-title">Presencia a Nivel Nacional</h3>
                <p class="card-description">Operamos en todo el territorio colombiano, con experiencia en proyectos de diversas regiones y sectores productivos del país.</p>
            </div>
        </div>
    </div>
</section>

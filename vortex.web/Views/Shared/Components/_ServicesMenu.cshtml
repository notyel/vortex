@* Menú lateral de navegación de servicios *@
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
}

<aside class="service-sidebar">

    @* Menú de servicios *@
    <nav class="services-menu-widget" aria-label="Navegación de servicios">
        <h3 class="services-menu-widget-title">Servicios</h3>
        <ul class="services-menu-list">
            <li>
                <a asp-controller="Services" asp-action="UtilityScale"
                   class="services-menu-link @(currentAction == "UtilityScale" ? "active" : "")">
                    <span class="material-icons" aria-hidden="true">check</span>
                    Desarrollo de Proyectos
                </a>
            </li>
            <li>
                <a asp-controller="Services" asp-action="DueDiligence"
                   class="services-menu-link @(currentAction == "DueDiligence" ? "active" : "")">
                    <span class="material-icons" aria-hidden="true">check</span>
                    Due Diligence Integral
                </a>
            </li>
            <li>
                <a asp-controller="Services" asp-action="Distribuida"
                   class="services-menu-link @(currentAction == "Distribuida" ? "active" : "")">
                    <span class="material-icons" aria-hidden="true">check</span>
                    Generación Distribuida
                </a>
            </li>
            <li>
                <a asp-controller="Services" asp-action="Electromovilidad"
                   class="services-menu-link @(currentAction == "Electromovilidad" ? "active" : "")">
                    <span class="material-icons" aria-hidden="true">check</span>
                    Electromovilidad
                </a>
            </li>
        </ul>
    </nav>

    @* Descarga de brochure *@
    <div class="brochure-widget">
        <a href="/docs/BROCHURE-VORTEX-RE-2025.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <span class="material-icons" aria-hidden="true">download</span>
            Descargar Brochure
        </a>
        <a href="/docs/BROCHURE-VORTEX-RE-2025.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            <span class="material-icons" aria-hidden="true">picture_as_pdf</span>
            Ver Brochure PDF
        </a>
    </div>

    @* Widget de contacto *@
    <div class="contact-widget">
        <div class="contact-widget-logo">
            <span class="material-icons" aria-hidden="true">bolt</span>
            <span class="contact-widget-logo-text">VORTEX</span>
        </div>
        <h4 class="contact-widget-headline">¿Necesitas ayuda?</h4>
        <p class="contact-widget-cta">Llamanos</p>
        <p class="contact-widget-phone">+57 300 4912788</p>
        <a asp-controller="Contact" asp-action="Index" class="btn btn-secondary">Contáctanos</a>
    </div>

</aside>

@* Footer Component - Pie de página *@

<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-section">
                <div class="footer-logo">
                    <img src="~/images/logo-horizontal-white.png" alt="VORTEX Renewables" />
                </div>
                <p>
                    Vortex Renewables es una compañía pionera en soluciones energéticas 100% limpias.
                </p>
                <div class="footer-social">
                    <a href="https://linkedin.com/company/vortex-renewables" target="_blank" class="footer-social-link" aria-label="LinkedIn">
                        <span class="material-icons">business</span>
                    </a>
                    <a href="mailto:info@vortex-renewables.com" class="footer-social-link" aria-label="Email">
                        <span class="material-icons">email</span>
                    </a>
                </div>
            </div>
            
            <div class="footer-section">
                <h3>Enlaces Rápidos</h3>
                <p><a asp-controller="Landing" asp-action="Index">Inicio</a></p>
                <p><a asp-controller="AboutUs" asp-action="Index">Sobre Nosotros</a></p>
                <p><a asp-controller="Services" asp-action="Index">Servicios</a></p>
                <p><a asp-controller="Contact" asp-action="Index">Contacto</a></p>
            </div>
            
            <div class="footer-section">
                <h3>Contacto</h3>
                <div class="footer-contact-item">
                    <span class="footer-contact-icon">
                        <span class="material-icons">phone</span>
                    </span>
                    <div>
                        <a href="tel:3004912788">300 4912788</a>
                    </div>
                </div>
                <div class="footer-contact-item">
                    <span class="footer-contact-icon">
                        <span class="material-icons">email</span>
                    </span>
                    <div>
                        <a href="mailto:info@vortex-renewables.com">info@vortex-renewables.com</a>
                    </div>
                </div>
            </div>
            
            <div class="footer-section">
                <h3>Ubicación</h3>
                <p>
                    <strong>Oficina Principal:</strong><br>
                    Calle 49 Sur #45A 300<br>
                    Edificio S48 Tower, Oficina 2213
                </p>
                <p style="margin-top: var(--spacing-md);">
                    <strong>Oficina Secundaria:</strong><br>
                    Carrera 43G Cl 19-142<br>
                    Oficina 2726
                </p>
            </div>
        </div>
        
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year VORTEX Renewables. Todos los derechos reservados.</p>
        </div>
    </div>
</footer>

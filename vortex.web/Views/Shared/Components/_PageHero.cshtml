@model PageHeroViewModel

<section class="page-hero">
    <div class="page-hero-overlay"></div>
    <div class="container">
        <div class="page-hero-content">
            <h1 class="page-hero-title">@Model.Title</h1>
            @if (Model.Breadcrumbs.Count > 0)
            {
                <nav class="page-hero-breadcrumb" aria-label="Breadcrumb">
                    @for (int i = 0; i < Model.Breadcrumbs.Count; i++)
                    {
                        var item = Model.Breadcrumbs[i];
                        if (item.IsActive)
                        {
                            <span class="breadcrumb-current" aria-current="page">@item.Label</span>
                        }
                        else
                        {
                            <a href="@item.Url" class="breadcrumb-link">@item.Label</a>
                        }
                        if (i < Model.Breadcrumbs.Count - 1)
                        {
                            <span class="breadcrumb-separator" aria-hidden="true">›</span>
                        }
                    }
                </nav>
            }
        </div>
    </div>
</section>

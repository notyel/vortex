@* Service Cards Component - Tarjetas destacadas de servicios *@

<div class="service-cards-grid">

            <div class="svc-card">
                <div class="svc-card-image-wrapper">
                    <img src="~/images/slider-1.jpg" alt="Desarrollo de Proyectos" class="svc-card-image" />
                    <div class="svc-card-badge svc-card-badge--yellow">
                        <span class="material-symbols-outlined">bolt</span>
                    </div>
                </div>
                <div class="svc-card-body">
                    <h3 class="svc-card-title">Desarrollo de Proyectos</h3>
                    <p class="svc-card-description">
                        Estructuramos proyectos de energía renovable a gran escala, gestionando permisos,
                        ingeniería y financiamiento para maximizar el retorno de tu inversión.
                    </p>
                    <a asp-controller="Services" asp-action="Index" class="svc-card-link">
                        Leer más <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

            <div class="svc-card">
                <div class="svc-card-image-wrapper">
                    <img src="~/images/slider-2.jpg" alt="Due Diligence Integral" class="svc-card-image" />
                    <div class="svc-card-badge svc-card-badge--blue">
                        <span class="material-symbols-outlined">manage_search</span>
                    </div>
                </div>
                <div class="svc-card-body">
                    <h3 class="svc-card-title">Due Diligence Integral</h3>
                    <p class="svc-card-description">
                        Evaluamos técnica, legal y financieramente tus proyectos renovables para asegurar
                        decisiones de inversión sólidas y minimizar riesgos.
                    </p>
                    <a asp-controller="Services" asp-action="Index" class="svc-card-link">
                        Leer más <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

            <div class="svc-card">
                <div class="svc-card-image-wrapper">
                    <img src="~/images/slider-3.jpg" alt="Generación Distribuida" class="svc-card-image" />
                    <div class="svc-card-badge svc-card-badge--pink">
                        <span class="material-symbols-outlined">solar_power</span>
                    </div>
                </div>
                <div class="svc-card-body">
                    <h3 class="svc-card-title">Generación Distribuida</h3>
                    <p class="svc-card-description">
                        Diseñamos e implementamos soluciones de autogeneración para empresas que buscan
                        reducir costos energéticos y avanzar hacia la sostenibilidad.
                    </p>
                    <a asp-controller="Services" asp-action="Index" class="svc-card-link">
                        Leer más <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

            <div class="svc-card">
                <div class="svc-card-image-wrapper">
                    <img src="~/images/energia-limpia.jpg" alt="Soluciones de Electromovilidad" class="svc-card-image" />
                    <div class="svc-card-badge svc-card-badge--green">
                        <span class="material-symbols-outlined">ev_station</span>
                    </div>
                </div>
                <div class="svc-card-body">
                    <h3 class="svc-card-title">Soluciones de Electromovilidad</h3>
                    <p class="svc-card-description">
                        Desarrollamos infraestructura de carga para vehículos eléctricos integrando
                        energías renovables para una movilidad limpia y eficiente.
                    </p>
                    <a asp-controller="Services" asp-action="Index" class="svc-card-link">
                        Leer más <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

            <div class="svc-card svc-card--featured">
                <div class="svc-card-featured-header">
                    <div class="svc-card-featured-icon">
                        <span class="material-symbols-outlined">workspace_premium</span>
                    </div>
                    <div class="svc-card-featured-dots" aria-hidden="true">
                        <span></span><span></span><span></span>
                        <span></span><span></span><span></span>
                        <span></span><span></span><span></span>
                    </div>
                </div>
                <div class="svc-card-body">
                    <span class="svc-card-tag">Nuestro Compromiso</span>
                    <h3 class="svc-card-title">Calidad, Excelencia y Compromiso</h3>
                    <p class="svc-card-description">
                        En VORTEX cada proyecto refleja nuestros más altos estándares. Nos comprometemos
                        con la excelencia técnica, la transparencia y resultados que superan expectativas.
                    </p>
                    <a asp-controller="AboutUs" asp-action="Index" class="svc-card-link">
                        Conoce VORTEX <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

        </div>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VORTEX Renewables</title>
    
    @* Preconnect para optimizar carga de fuentes de Google *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    @* Google Fonts - Rubik para títulos y Poppins como alternativa *@
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" />
    
    @* Preload Material Icons para evitar parpadeo *@
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" />
    
    @* Material Icons con font-display block para evitar FOUT *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" />
    
    @* CSS Base *@
    <link rel="stylesheet" href="~/css/base/reset.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base/form.css" asp-append-version="true" />
    
    @* CSS Components Base *@
    <link rel="stylesheet" href="~/css/components/components.css" asp-append-version="true" />
    
    @* CSS Layout *@
    <link rel="stylesheet" href="~/css/layout/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/footer.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="~/Views/Shared/Components/_Header.cshtml" />
    
    <main class="main-content @(ViewData["TransparentHeader"] != null ? "main-content--hero" : "")">
        @RenderBody()
    </main>
    
    
    
    <partial name="~/Views/Shared/Components/_Footer.cshtml" />
    
    @* Scripts Base *@
    <script src="~/js/navigation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

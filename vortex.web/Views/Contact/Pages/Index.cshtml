@{
    ViewData["Title"] = "Contacto - VORTEX Renewables";
}
<partial name="~/Views/Shared/Components/_PageHero.cshtml" model='@(new PageHeroViewModel
                                                           {
                                                               Title = "Contacto",
                                                               Breadcrumbs =
                                                               [
                                                                   new BreadcrumbItem { Label = "Inicio", Url = "/" },
                                                                   new BreadcrumbItem { Label = "Contacto" }
                                                               ]
                                                           })' />


@section Styles {
    <link rel="stylesheet" href="~/css/components/_page-hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/contact.css" asp-append-version="true" />
}

<section class="section contact-section-bg">
    <div class="container">
        <div class="contact-description">
            <p class="intro">
                Contamos con un equipo de ingenieros especializados en gestión predial integral para proyectos de infraestructura en todas sus etapas. Utilizamos tecnología de última generación para asegurar la precisión en la captura de datos catastrales y legales.
            </p>
            <p class="highlight contact-highlight">
                ¡Contáctanos y descubre cómo podemos ayudarte en tu próximo proyecto!
            </p>
        </div>
        <div class="contact-cards">
            <div class="contact-card">
                <span class="contact-icon-svg" aria-label="Whatsapp"></span>
                <div class="contact-card-title">Whatsapp</div>
                <div class="contact-card-info">(+57) 300 4912788</div>
            </div>
            <div class="contact-card">
                <span class="material-icons contact-icon">mail_outline</span>
                <div class="contact-card-title">Correo electrónico</div>
                <div class="contact-card-info">info@vortex-renewables.com</div>
            </div>
            <div class="contact-card">
                <span class="material-icons contact-icon">location_on</span>
                <div class="contact-card-title">Dirección</div>
                <div class="contact-card-info">Calle 49 Sur #45A 300<br>Edificio S48 Tower, Oficina 2213</div>
            </div>
        </div>
    </div>
</section>

<section class="section contact-form-section">
    <div class="container">
        <partial name="~/Views/Shared/Components/_ContactForm.cshtml" />
    </div>
</section>
